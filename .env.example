# Dataset configuration
DATASET_PATH=data/math-rollouts
PROBLEM_ID=3360
MODEL_NAME=deepseek-ai/DeepSeek-R1-Distill-Llama-8B

# OpenRouter API key (required for adversarial prompt generation)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Controller model for the adversarial prompt generation (default: google/gemini-3-pro-preview)
CONTROLLER_MODEL=google/gemini-3-pro-preview

# vLLM Configuration
VLLM_API_URL="http://localhost:8000/v1"
VLLM_TEMPERATURE=0.6
VLLM_TOP_P=0.95

# Directory to save experiment results
RESULTS_DIR=results